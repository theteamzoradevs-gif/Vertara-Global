# Copy to .env.local for local development:
#   cp .env.example .env.local

# MongoDB (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/gcc-advisor

# Auth.js — generate a strong secret for production, e.g.:
#   openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# Admin bootstrap (used by `npm run seed` and offline login fallback)
ADMIN_EMAIL=admin@gccadvisor.com
ADMIN_PASSWORD=ChangeMe123!

# Optional Calendly embed on /contact
NEXT_PUBLIC_CALENDLY_URL=

# Public contact defaults (overridable in admin SiteSettings)
NEXT_PUBLIC_CONTACT_EMAIL=hello@gccadvisor.com
NEXT_PUBLIC_CONTACT_PHONE=+91 80 4000 1200

# Founder notification email. Variable names only; never commit real credentials.
# FOUNDER_EMAIL falls back to ADMIN_EMAIL when unset.
FOUNDER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Gmail SMTP uses an App Password, not the account password:
# 1. Turn on 2-Step Verification for the Google account that will send mail.
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Set the variables above to:
#      SMTP_HOST=smtp.gmail.com
#      SMTP_PORT=587
#      SMTP_USER=the-gmail-address
#      SMTP_PASSWORD=the-16-character-app-password
#      SMTP_FROM=the-gmail-address
#      FOUNDER_EMAIL=the-founder-inbox
